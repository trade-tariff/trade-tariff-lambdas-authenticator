#!/usr/bin/env bash

[[ "$TRACE" ]] && set -o xtrace
set -o errexit
set -o nounset
set -o pipefail
set -o noclobber

declare -A DEPLOYMENT_BUCKETS=(
  ["development"]="trade-tariff-lambda-deployment-844815912454"
  ["staging"]="trade-tariff-lambda-deployment-451934005581"
  ["production"]="trade-tariff-lambda-deployment-382373577178"
)

declare -A USER_POOL_IDS=(
  ["development"]="eu-west-2_eYCVlIQL0"
  ["staging"]="eu-west-2_h8JF71jvX"
  ["production"]="eu-west-2_dtYQGsKs4"
)

declare -A LOG_LEVELS=(
  ["development"]="DEBUG"
  ["staging"]="INFO"
  ["production"]="WARN"
)

# Terraform (trade-tariff-platform-aws-terraform) generates the MCP token and
# the usage plan key, and stores both in the mcp-shared-credentials secret in
# each account. Reading them here means the values cannot differ from the
# ones on the API Gateway and the WAF.
#
# A secret with no value means mcp_enabled is false in that environment, so
# the values stay empty and the authorizer bills all traffic to per-user
# plans. Any other error stops the deploy.
read_mcp_credentials() {
  local error_file
  local secret_json
  error_file="$(mktemp)"

  if secret_json="$(aws secretsmanager get-secret-value \
    --region eu-west-2 \
    --secret-id mcp-shared-credentials \
    --query SecretString \
    --output text 2>|"$error_file")"; then
    MCP_SECRET_TOKEN="$(jq --exit-status --raw-output '.MCP_SECRET_TOKEN' <<<"$secret_json")" || {
      echo "mcp-shared-credentials has no MCP_SECRET_TOKEN" >&2
      return 1
    }
    MCP_USAGE_KEY="$(jq --exit-status --raw-output '.MCP_USAGE_KEY' <<<"$secret_json")" || {
      echo "mcp-shared-credentials has no MCP_USAGE_KEY" >&2
      return 1
    }
    echo "MCP usage plan is on"
  elif grep --quiet ResourceNotFoundException "$error_file"; then
    MCP_SECRET_TOKEN=""
    MCP_USAGE_KEY=""
    echo "mcp-shared-credentials has no value, so the MCP usage plan is off"
  else
    cat "$error_file" >&2
    return 1
  fi
}

deploy() {
  local stage="$1"
  local bucket="${DEPLOYMENT_BUCKETS[$stage]}"
  local user_pool_id="${USER_POOL_IDS[$stage]}"
  local log_level="${LOG_LEVELS[$stage]}"

  read_mcp_credentials || return 1

  STAGE="$stage" \
  AWS_REGION="eu-west-2" \
  DEPLOYMENT_BUCKET="$bucket" \
  USER_POOL_ID="$user_pool_id" \
  LOG_LEVEL="$log_level" \
  MCP_SECRET_TOKEN="$MCP_SECRET_TOKEN" \
  MCP_USAGE_KEY="$MCP_USAGE_KEY" \
    serverless deploy
}

main() {
  if [ $# -lt 1 ]; then
    echo "Usage: $0 <stage>"
    exit 1
  fi

  deploy "$1"
}

main "$@"
